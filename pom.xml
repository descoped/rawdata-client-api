<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" child.project.url.inherit.append.path="false" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- Parent and aggregator of every module. All modules share this version and are released together. -->
    <groupId>io.descoped.rawdata</groupId>
    <artifactId>rawdata-client-project</artifactId>
    <version>3.0.2-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Rawdata Client Project</name>
    <description>A provider based API for writing and reading ordered streams of raw data messages, with providers
        for PostgreSQL and for Avro files in a local folder, Google Cloud Storage or Amazon S3, and a tool that copies
        topics from one provider to another.
    </description>
    <url>https://github.com/descoped/rawdata-client-project</url>
    <inceptionYear>2019</inceptionYear>

    <modules>
        <module>rawdata-client-bom</module>
        <module>rawdata-client-api</module>
        <module>rawdata-client-tck</module>
        <module>rawdata-client-provider-postgres</module>
        <module>rawdata-client-provider-avro</module>
        <module>rawdata-client-provider-filesystem</module>
        <module>rawdata-client-provider-gcs</module>
        <module>rawdata-client-provider-s3</module>
        <module>rawdata-copy-util</module>
    </modules>

    <properties>
        <!-- Surefire's JVM arguments; empty unless the coverage profile's JaCoCo agent sets it. A module that adds its
             own refers to it as @{argLine}. -->
        <argLine />
        <java.version>17</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- Reproducible builds: every jar entry gets this time, so the same tag builds the same bytes.
             release:prepare sets it to the release time. -->
        <project.build.outputTimestamp>2026-11-19T14:59:27Z</project.build.outputTimestamp>

        <!-- Dependency versions. Kept as properties, not in dependencyManagement, so that importing
             rawdata-client-bom (which inherits this POM) manages the rawdata modules only. -->
        <service-provider-api.version>3.0.1</service-provider-api.version>
        <slf4j.version>2.0.20</slf4j.version>
        <jackson.version>2.23.0</jackson.version>
        <commons-codec.version>1.23.0</commons-codec.version>
        <logback.version>1.6.8</logback.version>
        <hikaricp.version>7.1.0</hikaricp.version>
        <postgresql.version>42.7.14</postgresql.version>
        <avro.version>1.12.2</avro.version>
        <aws-sdk.version>2.59.7</aws-sdk.version>
        <junit.version>6.1.3</junit.version>
        <testcontainers.version>2.0.5</testcontainers.version>
    </properties>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Ove Ranheim</name>
            <email>ove.ranheim@gmail.com</email>
            <url>https://www.linkedin.com/in/oranheim/</url>
            <organization>Descoped</organization>
            <organizationUrl>https://github.com/descoped/</organizationUrl>
        </developer>
    </developers>

    <contributors>
        <contributor>
            <name>Kim Christian Gaarder</name>
            <url>https://www.linkedin.com/in/kimchristiangaarder/</url>
        </contributor>
    </contributors>

    <!-- The modules live in this repository: their url and scm are the project's, not <url>/<artifactId>. -->
    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
        <connection>scm:git:git://github.com/descoped/rawdata-client-project.git</connection>
        <developerConnection>scm:git:git@github.com:descoped/rawdata-client-project.git</developerConnection>
        <url>https://github.com/descoped/rawdata-client-project</url>
        <tag>HEAD</tag>
    </scm>

    <profiles>
        <!-- Releases to Maven Central through the Central Portal, by central-publishing-maven-plugin. Only releases:
             SNAPSHOTs are not published.
             Release (Ove approves each one): ./mvnw release:prepare release:perform
             Server `central` in ~/.m2/settings.xml holds the Portal user token and, for Maven 3.10, lists
             https://central.sonatype.com in repositoryOrigins. Releases are uploaded with autoPublish=false and
             published by hand in the Portal. -->
        <profile>
            <id>central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                            <!-- The copy tool is a program, distributed as a zip on GitHub releases. -->
                            <excludeArtifacts>
                                <excludeArtifact>rawdata-copy-util</excludeArtifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Signing, required by Central for releases. gpg's default-key signs (see ~/.m2/NOTES.md). -->
        <profile>
            <id>sign</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.16</version>
                        <executions>
                            <execution>
                                <id>prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>report</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- One SonarCloud project for the whole reactor; each module reports its own JaCoCo XML, the API module's
             classes also get the coverage of the contract tests (rawdata-client-tck's aggregate report), and the Avro
             engine that of the filesystem, gcs and s3 tests (rawdata-copy-util's aggregate report). -->
        <profile>
            <id>sonar</id>
            <properties>
                <sonar.host.url>https://sonarcloud.io</sonar.host.url>
                <sonar.organization>descoped</sonar.organization>
                <sonar.projectKey>descoped_rawdata-client-project</sonar.projectKey>
                <sonar.coverage.jacoco.xmlReportPaths>target/site/jacoco/jacoco.xml,${maven.multiModuleProjectDirectory}/rawdata-client-tck/target/site/jacoco-aggregate/jacoco.xml,${maven.multiModuleProjectDirectory}/rawdata-copy-util/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonarsource.scanner.maven</groupId>
                        <artifactId>sonar-maven-plugin</artifactId>
                        <version>5.9.0.7382</version>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                    <configuration>
                        <compilerArgs>
                            <arg>-Xlint:all</arg>
                            <arg>-Werror</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.1</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                    <configuration>
                        <doclint>all</doclint>
                        <failOnWarnings>true</failOnWarnings>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-dependency-plugin</artifactId>
                    <version>3.11.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-assembly-plugin</artifactId>
                    <version>3.8.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-release-plugin</artifactId>
                    <version>3.3.1</version>
                    <configuration>
                        <tagNameFormat>v@{project.version}</tagNameFormat>
                        <autoVersionSubmodules>true</autoVersionSubmodules>
                        <releaseProfiles>central,sign</releaseProfiles>
                        <goals>deploy</goals>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.7.0</version>
                <executions>
                    <execution>
                        <id>enforce</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>${java.version}</version>
                                </requireJavaVersion>
                                <!-- Sonatype's central-publishing-maven-plugin does not support Maven 4. -->
                                <requireMavenVersion>
                                    <version>[3.6.3,4)</version>
                                </requireMavenVersion>
                                <!-- Predictable dependencies for applications: one version of each library in the
                                     compile and runtime trees. Where two libraries bring different versions, the
                                     module declares it at the newest and the other path excludes it. -->
                                <dependencyConvergence>
                                    <excludedScopes>
                                        <excludedScope>test</excludedScope>
                                        <excludedScope>provided</excludedScope>
                                    </excludedScopes>
                                </dependencyConvergence>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
