<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.descoped.rawdata</groupId>
        <artifactId>rawdata-client-project</artifactId>
        <version>3.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>rawdata-client-tck</artifactId>
    <packaging>jar</packaging>

    <name>Rawdata Client TCK</name>
    <description>The contract tests every RawdataClient provider must pass, as JUnit tests to extend.</description>

    <!-- The contract tests are this module's product, so they live in src/main; SonarCloud analyses them as tests. -->
    <properties>
        <sonar.sources>pom.xml</sonar.sources>
        <sonar.tests>src/main/java,src/test/java</sonar.tests>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.descoped.rawdata</groupId>
            <artifactId>rawdata-client-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- For the store TCK, AvroStoreContractTest, run by the providers built on the Avro engine. -->
        <dependency>
            <groupId>io.descoped.rawdata</groupId>
            <artifactId>rawdata-client-provider-avro</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <version>${junit.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <version>${junit.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- The contract tests run against the memory provider, which lives in rawdata-client-api: the aggregate report
             gives the API module's classes the coverage of these tests, and SonarCloud merges it with the API's own. -->
        <profile>
            <id>coverage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>report-aggregate</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report-aggregate</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
