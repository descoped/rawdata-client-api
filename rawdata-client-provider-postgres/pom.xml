<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.descoped.rawdata</groupId>
        <artifactId>rawdata-client-project</artifactId>
        <version>3.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>rawdata-client-provider-postgres</artifactId>
    <packaging>jar</packaging>

    <name>Rawdata Client Provider PostgreSQL</name>
    <description>RawdataClient provider that stores topics in PostgreSQL.</description>

    <build>
        <plugins>
            <!-- The PostgreSQL driver is an automatic module (no module-info), which javac reports with
                 -Xlint:requires-automatic; that is expected here, every other lint warning still fails. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs combine.self="override">
                        <arg>-Xlint:all,-requires-automatic</arg>
                        <arg>-Werror</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <!-- A provider exports no package: its classes are implementation, reached only through the
                 RawdataClient API. Doclint still checks the Javadoc that is there, but does not require it. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <doclint>all,-missing</doclint>
                </configuration>
            </plugin>
            <!-- The tests run PostgreSQL 18 in Docker through Testcontainers, whose dependencies are automatic modules
                 with split packages, so they run on the class path (the provider is found through
                 META-INF/services). The module path is covered by the JPMS smoke test. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>io.descoped.rawdata</groupId>
            <artifactId>rawdata-client-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>${hikaricp.version}</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
        </dependency>
        <dependency>
            <groupId>io.descoped.rawdata</groupId>
            <artifactId>rawdata-client-tck</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- IntelliJ IDEA runs these tests on the module path, patched into io.descoped.rawdata.provider.postgres, even though Surefire is set to the
             class path. The module does not open the test package to JUnit or read the test modules, so every test
             failed there with InaccessibleObjectException. IntelliJ sets idea.maven.embedder.version when it imports
             the project and passes Surefire's argLine to its test runs; Maven and CI never activate this profile. -->
        <profile>
            <id>intellij</id>
            <activation>
                <property>
                    <name>idea.maven.embedder.version</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <argLine>@{argLine} --add-reads io.descoped.rawdata.provider.postgres=ALL-UNNAMED,org.junit.jupiter.api,io.descoped.rawdata.tck --add-opens io.descoped.rawdata.provider.postgres/io.descoped.rawdata.provider.postgres.test=ALL-UNNAMED,org.junit.platform.commons</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
