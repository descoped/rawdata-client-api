<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.descoped.rawdata</groupId>
        <artifactId>rawdata-client-project</artifactId>
        <version>3.0.1</version>
    </parent>

    <artifactId>rawdata-client-provider-gcs</artifactId>
    <packaging>jar</packaging>

    <name>Rawdata Client Provider GCS</name>
    <description>The gcs RawdataClient provider: topics as Avro files in a Google Cloud Storage bucket, through the GCS JSON API on the JDK's HTTP client.</description>

    <build>
        <plugins>
            <!-- The credential and client tests play Google's endpoints with the JDK's HTTP server; the tests are
                 compiled into the module, which reads it only for them. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <compilerArgs combine.children="append">
                                <arg>--add-modules</arg>
                                <arg>jdk.httpserver</arg>
                                <arg>--add-reads</arg>
                                <arg>io.descoped.rawdata.provider.gcs=jdk.httpserver</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- The tests run a fake GCS server in Docker through Testcontainers, whose dependencies are automatic
                 modules with split packages, so they run on the class path. The module path is covered by the JPMS
                 smoke test. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>io.descoped.rawdata</groupId>
            <artifactId>rawdata-client-provider-avro</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- The GCS JSON API's responses and the credentials files; the same version as the Avro engine's. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>io.descoped.rawdata</groupId>
            <artifactId>rawdata-client-tck</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- IntelliJ IDEA runs these tests on the module path, patched into io.descoped.rawdata.provider.gcs, even
             though Surefire is set to the class path. These arguments open the test packages to JUnit and let them
             read the test modules (see the postgres module). Maven and CI never activate this profile. -->
        <profile>
            <id>intellij</id>
            <activation>
                <property>
                    <name>idea.maven.embedder.version</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <argLine>@{argLine} --add-modules jdk.httpserver --add-reads io.descoped.rawdata.provider.gcs=ALL-UNNAMED,org.junit.jupiter.api,jdk.httpserver --add-opens io.descoped.rawdata.provider.gcs/io.descoped.rawdata.provider.gcs=ALL-UNNAMED,org.junit.platform.commons --add-opens io.descoped.rawdata.provider.gcs/io.descoped.rawdata.provider.gcs.test=ALL-UNNAMED,org.junit.platform.commons --add-exports org.junit.platform.commons/org.junit.platform.commons.util=ALL-UNNAMED --add-exports org.junit.platform.commons/org.junit.platform.commons.logging=ALL-UNNAMED</argLine>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
